{
  "name": "fern-agent-engine",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "biome check . && npm run typecheck && npm test",
    "format": "biome check --write .",
    "agent": "node tools/agent.ts",
    "physics": "node tools/physics.ts",
    "bench": "node tools/bench.ts",
    "bench:browser": "node tools/browser-bench.ts",
    "bench:quality": "node tools/quality-bench.ts",
    "bench:combat": "node tools/combat-bench.ts",
    "assets": "node tools/assets.ts",
    "docs": "node tools/docs.ts",
    "signal": "node tools/signal.ts",
    "adventure": "node tools/adventure.ts",
    "verify:run": "node tools/adventure.ts playthrough 9"
  },
  "dependencies": {
    "@dimforge/rapier2d-compat": "0.21.0",
    "peerjs": "1.5.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "peer": "1.0.2",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  }
}
